{
  "build": {
    "beforeBuildCommand": "cd frontend && npm run build",
    "beforeDevCommand": "cd frontend && npm run dev",
    "devPath": "http://localhost:1420",
    "distDir": "frontend/dist"
  },
  "productName": "ARC",
  "version": "0.1.0",
  "package": {
    "name": "arc",
    "type": "rust"
  },
  "tauri": {
    "identifier": "com.arc.cad",
    "bundle": {
      "identifier": "com.arc.cad",
      "publisher": "ARC Contributors",
      "license": "MIT OR Apache-2.0",
      "icon": [
        "frontend/src/assets/icons/icon.png",
        "frontend/src/assets/icons/icon.icns",
        "frontend/src/assets/icons/icon.ico"
      ],
      "targets": {
        "darwin": {
          "category": "public.app-category.graphics-design",
          "minimumSystemVersion": "11.0",
          "entitlements": null,
          "exceptionDomain": null
        },
        "windows": {
          "certificatePath": null,
          "certificatePassword": null,
          "allowedNsisErrors": null
        },
        "linux": {
          "appimage": true,
          "deb": {
            "depends": ["libgtk-3-0", "libwebkit2gtk-4.1-39", "libssl3", "libappindicator3-1", "libpng16-16"]
          },
          "rpm": {
            "depends": ["gtk3", "webkit2gtk3-jsc", "openssl", "libappindicator-gtk3"]
          }
        }
      }
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws:://localhost:*"
    },
    "systemTray": {
      "iconPath": "frontend/src/assets/icons/tray.svg"
    },
    "windows": [
      {
        "url": "frontend/index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "title": "ARC",
        "windowClass": "arc-main",
        "label": "main",
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "dark"
      }
    ]
  }
}
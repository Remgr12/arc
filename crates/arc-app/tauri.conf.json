{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.arc.cad",
  "productName": "arc",
  "version": "0.1.0",
  "build": {
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws://localhost:*"
    },
    "trayIcon": {
      "iconPath": "../../frontend/src/assets/icons/tray.svg"
    },
    "windows": [
      {
        "label": "main",
        "title": "arc",
        "url": "../../frontend/index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../frontend/src/assets/icons/icon.png",
      "../../frontend/src/assets/icons/icon.icns",
      "../../frontend/src/assets/icons/icon.ico"
    ],
    "publisher": "arc Contributors",
    "license": "MIT OR Apache-2.0",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "exceptionDomain": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-39",
          "libssl3",
          "libappindicator3-1",
          "libpng16-16"
        ]
      },
      "rpm": {
        "depends": [
          "gtk3",
          "webkit2gtk3-jsc",
          "openssl",
          "libappindicator-gtk3"
        ]
      }
    }
  }
}